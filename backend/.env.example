# Copy to .env (git-ignored) and fill in. Never commit a real key.
LLM_API_KEY=your-key-here
# Provider: "gemini" (free key from aistudio.google.com) or leave unset for Anthropic
LLM_PROVIDER=gemini
# Optional
# LLM_MODEL=gemini-2.5-flash
# LLM_MODE=mock   # serve backend/demo_outputs/ instead of calling the API
